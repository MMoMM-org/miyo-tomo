{
  "model": "sonnet",
  "outputStyle": "tomo-companion",
  "companyAnnouncements": [
    "Run /inbox to triage your Obsidian inbox \u2014 Tomo proposes where each note belongs, you approve.",
    "Stuck or curious? Run /tomo-help for context-aware guidance on any Tomo workflow.",
    "Got an under-organised topic? /moc-propose drafts a Map-of-Content into your inbox for review."
  ],
  "permissions": {
    "allow": [
      "mcp__kado__*",
      "Bash(python3 scripts/*.py*)",
      "Bash(python3 scripts/lib/*.py*)",
      "Bash(python3:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(awk:*)",
      "Bash(date:*)",
      "Bash(mkdir:*)",
      "Bash(mkdir -p tomo-tmp/*)",
      "Bash(echo:*)",
      "Bash(claude:*)",
      "Bash(rm -f tomo-tmp/*)",
      "Bash(rm -rf tomo-tmp/*)",
      "Skill(*)",
      "Read(*)",
      "Edit(config/*)",
      "Write(config/*)",
      "Edit(.claude/*)",
      "Write(.claude/*)",
      "Edit(tomo-tmp/*)",
      "Write(tomo-tmp/*)"
    ],
    "deny": []
  },
  "statusLine": {
    "type": "command",
    "command": "bash scripts/tomo-statusline.sh"
  },
  "fileSuggestion": {
    "type": "command",
    "command": "bash .claude/scripts/file-suggestion.sh"
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Knocking on \u9580's gate",
      "Passing through \u9580's gate",
      "Querying the vault",
      "Traversing MOC tree",
      "Scanning note frontmatter",
      "Reading inbox files",
      "Classifying notes",
      "Matching to MOCs",
      "Weighing confidence scores",
      "Building suggestion set",
      "Rendering templates",
      "Writing instruction set",
      "\u53cb is thinking",
      "\u53cb is listening",
      "\u53cb is making sense of things",
      "Consulting the knowledge stack",
      "Checking layer precedence",
      "Honoring user config",
      "Finding the right home for your notes",
      "Connecting the dots",
      "Reading between the lines",
      "Mapping your thoughts",
      "Tending the vault",
      "\u53cb and \u9580 are best friends",
      "\u53cb and \u6a4b build bridges together",
      "\u53cb plans, \u6a4b builds",
      "\u6a4b carries \u53cb's intent across",
      "\u6a4b lets you watch \u53cb think",
      "Through \u6a4b you see \u53cb at work",
      "Unearthing the Gardener",
      "Blueprinting the Architect"
    ]
  },
  "effortLevel": "high",
  "enabledPlugins": {},
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/dev-notify-bridge.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "ScheduleWakeup",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/block-inbox-selfschedule.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/block-state-file-handwrite.sh"
          }
        ]
      }
    ],
    "MessageDisplay": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/wikilink-highlight.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
