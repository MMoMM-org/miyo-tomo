{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tomo Inbox Routing Plan",
  "type": "object",
  "required": ["action", "timestamp", "inbox_path"],
  "additionalProperties": false,
  "properties": {
    "action": {
      "type": "string",
      "enum": ["suggest", "fan-resolve", "synthesize", "transcribe", "idle"],
      "description": "Which conductor to impersonate, or idle/transcribe"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "inbox_path": {
      "type": "string",
      "description": "Vault-relative inbox folder path"
    },
    "fresh_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string"},
          "modified": {"type": "string"}
        }
      },
      "description": "New .md files not yet classified"
    },
    "has_audio": {
      "type": "boolean",
      "description": "True if uncached audio files exist in inbox"
    },
    "approved_suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string"},
          "modified": {"type": "string"},
          "cache_path": {"type": "string"},
          "wire_cache_path": {"type": "string", "description": "ADR-026: local cache path of the _suggestions.json wire sibling, when present. Threaded to the synthesis-conductor so Pass-2 can prefer an edited JSON (build_from_wire)."}
        }
      },
      "description": "Suggestions docs with [x] Approved ticked"
    },
    "approved_fan": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string"},
          "modified": {"type": "string"},
          "cache_path": {"type": "string"},
          "wire_cache_path": {"type": "string", "description": "ADR-026: local cache path of the _suggestions-fan.json wire sibling, when present. Threaded to the conductor so a Hashi-edited fan doc resolves JSON-only (build_from_wire) in the standalone-fan path."}
        }
      },
      "description": "Suggestions-fan docs with [x] Approved ticked"
    },
    "approved_moc_proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string"},
          "modified": {"type": "string"},
          "cache_path": {"type": "string"}
        }
      },
      "description": "MOC-proposal docs with [x] Accept ticked"
    },
    "approved_garden_audits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string"},
          "modified": {"type": "string"},
          "cache_path": {"type": "string"},
          "wire_cache_path": {"type": "string", "description": "ADR-4 / ADR-026: local cache path of the garden-audit-wire.json sibling, when present. Threaded to garden-audit-parser for wire-digest-based acceptance."}
        }
      },
      "description": "Garden-audit docs in pending-accept state (ADR-1, spec 030); accepted unconditionally."
    },
    "force_atomic_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stem", "source_path"],
        "additionalProperties": false,
        "properties": {
          "stem": {"type": "string"},
          "source_path": {"type": "string"},
          "section_id": {"type": "string"}
        }
      },
      "description": "Items with [x] Force Atomic Note ticked"
    },
    "pending_approval": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "doc_type"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string"},
          "doc_type": {"type": "string"},
          "message": {"type": "string"}
        }
      },
      "description": "Docs awaiting user approval (not yet ticked)"
    },
    "idle_reasons": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Human-readable reasons for idle action"
    },
    "drift_indicators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "type"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string"},
          "type": {"type": "string", "enum": ["checksum_mismatch", "orphaned_state", "missing_source", "stale_cache"]},
          "detail": {"type": "string"}
        }
      },
      "description": "Drift warnings (non-blocking in v1)"
    },
    "skip_stems": {
      "type": "array",
      "items": {"type": "string"},
      "description": "F-9: stems to exclude from suggestion-conductor"
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total_ms": {"type": "number"},
        "discover_ms": {"type": "number"},
        "kado_calls": {"type": "integer"},
        "docs_cached": {"type": "integer"}
      }
    },
    "handled": {
      "type": "array",
      "description": "Inbox items routed by a tag-handler. Omitted entirely when the registry is empty (AC-5). Pass-1 skips handled items.",
      "items": {
        "type": "object",
        "required": ["path", "handler", "vars", "target_path", "action"],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Vault-relative path of the inbox item."
          },
          "handler": {
            "type": "string",
            "minLength": 1,
            "description": "ID of the tag-handler that claimed this item."
          },
          "vars": {
            "type": "object",
            "additionalProperties": {"type": "string"},
            "description": "Captured segment values keyed by segment name (string→string)."
          },
          "target_path": {
            "type": ["string", "null"],
            "description": "Resolved vault-relative target path, or null when the target map had no entry for the captured vars."
          },
          "marker": {
            "type": "string",
            "minLength": 1,
            "description": "Anchor string in the target note (mirrors tag-handler config)."
          },
          "action": {
            "type": "string",
            "enum": ["insert_under_marker", "route_to_folder", "link_to_moc", "enrich_frontmatter"],
            "description": "Action registry value from the handler config. Mirrors tag-handler.schema.json:43."
          },
          "placement": {
            "type": "string",
            "enum": ["inside", "before", "after"],
            "description": "Insertion position relative to the anchor."
          },
          "compose": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "description": "LLM directive from the handler config."
              },
              {
                "type": "array",
                "items": {"type": "string", "minLength": 1},
                "minItems": 1,
                "description": "Mechanical template: ordered list of frontmatter field names."
              }
            ],
            "description": "Compose directive from the handler config (string or array-of-strings)."
          },
          "output_format": {
            "type": "object",
            "description": "Structure-aware output spec, carried verbatim from the handler config (spec 025). Already validated against tag-handler.schema.json at config-load time; kept permissive here to avoid triplicating the strict shape (canonical definitions: tag-handler.schema.json + tag-handler-group.schema.json)."
          }
        }
      }
    }
  }
}
