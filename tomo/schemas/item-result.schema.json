{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://miyo.tomo/schemas/item-result.schema.json",
  "title": "Item Classifier Result",
  "description": "Output of a Phase-B subagent for a single inbox item. Polymorphic actions[] — an item may produce multiple actions.",
  "type": "object",
  "required": ["schema_version", "stem", "path", "type", "type_confidence", "actions"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1"},
    "stem": {"type": "string", "minLength": 1},
    "path": {"type": "string", "minLength": 1},
    "type": {"type": "string"},
    "type_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "date_relevance": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["date", "source"],
          "additionalProperties": false,
          "properties": {
            "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
            "source": {"type": "string", "enum": ["filename", "frontmatter", "content"]}
          }
        }
      ]
    },
    "issues": {"type": "array", "items": {"type": "string"}},
    "duration_ms": {"type": "integer", "minimum": 0},
    "force_atomic": {
      "type": "boolean",
      "description": "Set by the analyst when dispatched with force_atomic=true (XDD-012 FAN resolve subflow). Consumed by suggestions-reducer.py --fan-resolve to filter the resolve doc to fan-triggered items only. Optional; absent or false means a normal Pass-1 result."
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/create_atomic_note"},
          {"$ref": "#/$defs/update_daily"},
          {"$ref": "#/$defs/create_moc"},
          {"$ref": "#/$defs/modify_note"}
        ]
      }
    }
  },
  "$defs": {
    "create_atomic_note": {
      "type": "object",
      "description": "One atomic note to create from the source inbox item. actions[] may carry N>=2 create_atomic_note entries from the same source — each represents one worthy thread (ADR-2, ADR-4, F-41).",
      "required": ["kind", "source_stem", "suggested_title", "template", "location", "candidate_mocs", "tags_to_add"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "create_atomic_note"},
        "source_stem": {
          "type": "string",
          "minLength": 1,
          "description": "The inbox item's filename stem (without extension). Groups N atomics back to one source. Required for ALL items — not just multi-thread — for downstream uniformity (ADR-4)."
        },
        "suggested_title": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1,
                    "description": "One-sentence gist of THIS thread's content, for display only (never used for scoring). Lets the user/editor see what the note is about without opening it. Optional — absent on legacy results."},
        "template": {"type": "string", "minLength": 1,
                     "description": "Obsidian template file name (e.g. 'Atomic Note.md') or concept key (e.g. 'atomic_note') — whichever the user's templates.mapping exposes."},
        "location": {"type": "string", "minLength": 1,
                     "description": "Target folder path, vault-relative, trailing slash (e.g. 'Atlas/202 Notes/')."},
        "candidate_mocs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "score", "pre_check"],
            "additionalProperties": false,
            "properties": {
              "path": {"type": "string"},
              "score": {"type": "number", "minimum": 0, "maximum": 1},
              "pre_check": {"type": "boolean"},
              "anchor": {
                "type": "object",
                "description": "Optional insertion hint resolved by the LLM from MOC headings/callouts. Carried forward into the instruction-render step to produce a concrete link_to_moc anchor. Absent when the LLM could not identify a suitable insertion point.",
                "required": ["type", "value", "placement"],
                "additionalProperties": false,
                "properties": {
                  "type": {"type": "string", "enum": ["heading", "callout", "line"], "description": "What kind of anchor the LLM matched."},
                  "value": {"type": ["string", "null"], "description": "Text of the matched anchor, or null when unresolved."},
                  "placement": {"type": "string", "enum": ["inside", "before", "after"], "description": "Where to insert relative to the matched anchor."},
                  "new_section": {"type": ["string", "null"], "description": "Optional heading text to create as a new section when the MOC lacks a suitable anchor. Null when not needed."},
                  "alt_headings": {"type": ["array", "null"], "items": {"type": "string", "minLength": 1, "pattern": "^[^\\n\\r]+$"},
                    "description": "Runner-up heading text(s) Pass-1 also judged a plausible fit (AC-16 ambiguous-fit advisory). Present only when ≥2 headings genuinely fit; absent/null otherwise. Does NOT change the chosen anchor in `value`."},
                  "fit_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1,
                    "description": "LLM 0-1 confidence in the chosen tier-1 heading's semantic fit. Present only for tier-1 heading anchors; null/absent for tiers 2-4 and legacy results."}
                }
              }
            }
          }
        },
        "classification": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["category", "confidence"],
              "additionalProperties": false,
              "properties": {
                "category": {"type": "string"},
                "confidence": {"type": "number", "minimum": 0, "maximum": 1}
              }
            }
          ]
        },
        "needs_new_moc": {"type": "boolean"},
        "proposed_moc_topic": {"type": ["string", "null"]},
        "tags_to_add": {"type": "array", "items": {"type": "string"}},
        "audio_peer": {
          "type": ["string", "null"],
          "description": "Vault-relative path to the companion audio file when this item is a voice transcript (e.g. '100 Inbox/recording.m4a'). Derived from the transcript's source: frontmatter key (written by voice_render.py). Null or absent for non-voice items (ADR-1, ADR-2)."
        },
        "attachments": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Resolved vault-relative paths of embedded attachment files (e.g. '100 Inbox/Images/karte.jpg'). Optional; absent or empty means no resolvable attachment embeds."
        },
        "atomic_note_worthiness": {"type": "number", "minimum": 0, "maximum": 1},
        "alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "reason"],
            "additionalProperties": false,
            "properties": {
              "kind": {"type": "string"},
              "reason": {"type": "string"}
            }
          }
        }
      }
    },
    "update_daily": {
      "type": "object",
      "required": ["kind", "date", "daily_note_path", "updates"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "update_daily"},
        "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "daily_note_stem": {"type": "string"},
        "daily_note_path": {"type": "string"},
        "updates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {"$ref": "#/$defs/update_tracker"},
              {"$ref": "#/$defs/update_log_entry"},
              {"$ref": "#/$defs/update_log_link"}
            ]
          }
        }
      }
    },
    "update_tracker": {
      "type": "object",
      "required": ["kind", "field", "value", "syntax", "confidence", "reason"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "tracker"},
        "field": {"type": "string"},
        "value": {"type": ["string", "number", "boolean"]},
        "syntax": {"type": "string", "enum": ["inline_field", "callout_body", "checkbox"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "reason": {"type": "string"},
        "section": {"type": "string"}
      }
    },
    "update_log_entry": {
      "type": "object",
      "required": ["kind", "content", "reason", "confidence", "position"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "log_entry"},
        "content": {"type": "string"},
        "reason": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "position": {"type": "string", "enum": ["after_last_line", "before_first_line", "at_time"],
                     "description": "Where to place the entry in the daily log section. at_time requires time field."},
        "time": {
          "oneOf": [
            {"type": "string", "pattern": "^[0-9]{2}:[0-9]{2}$"},
            {"type": "null"}
          ]
        },
        "time_source": {"type": "string"}
      }
    },
    "update_log_link": {
      "type": "object",
      "required": ["kind", "target_stem", "reason", "confidence", "position"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "log_link"},
        "target_stem": {"type": "string"},
        "reason": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "position": {"type": "string", "enum": ["after_last_line", "before_first_line", "at_time"],
                     "description": "Where to place the link in the daily log section. at_time requires time field."},
        "time": {
          "oneOf": [
            {"type": "string", "pattern": "^[0-9]{2}:[0-9]{2}$"},
            {"type": "null"}
          ]
        },
        "time_source": {"type": "string"}
      }
    },
    "create_moc": {
      "type": "object",
      "required": ["kind", "moc_title", "parent_moc"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "create_moc"},
        "moc_title": {"type": "string"},
        "parent_moc": {"type": "string"}
      }
    },
    "modify_note": {
      "type": "object",
      "required": ["kind", "target_path", "diff_description"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "modify_note"},
        "target_path": {"type": "string"},
        "diff_description": {"type": "string"}
      }
    }
  }
}
