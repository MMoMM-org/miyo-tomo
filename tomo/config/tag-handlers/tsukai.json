{
  "id": "tsukai",
  "enabled": true,
  "match": {
    "tag_prefix": "MiYo/Tsukai/",
    "capture_segments": ["repo"],
    "read_fields": ["category", "created"]
  },
  "action": "insert_under_marker",
  "target": {
    "by": "repo",
    "map": {}
  },
  "marker": "## Captures",
  "placement": "after",
  "compose": "Synthesize the batch's captures into one dated logical status update, grouped by category.",
  "output_format": {
    "structure": "table_row",
    "order": "newest_first",
    "granularity": "per_item",
    "cells": [
      {"field": "created"},
      {"field": "category"},
      {"synthesize": "one-line summary of what changed"}
    ]
  }
}
