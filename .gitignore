# Tomo instance (created by install-tomo.sh, name may differ)
# The actual entry is added dynamically by install-tomo.sh
tomo-instance/

# Tomo Docker home (Claude Code home directory for container)
tomo-home/

# Tomo backup archives (sibling to tomo-instance/, created by backup-tomo.sh)
tomo-backups/

# Tomo scratch dir — host-side working state (audit reports, session snapshots,
# intermediate run outputs). Never part of repo history.
tomo-tmp/

# Install config (contains local paths and tokens)
tomo-install.json

# Generated launcher (rendered by install-tomo.sh from scripts/begin-tomo.sh.template)
begin-tomo.sh

# Generated updater shim (rendered from scripts/lib/update-tomo.sh.launcher.template).
# Anchored to repo root so it never matches the real scripts/update-tomo.sh.
/update-tomo.sh

# Claude Code session files
.claude.json
.credentials.json
.claude/settings.local.json
.claude/plans/
.claude/.session-checkpoint*
.claude/scheduled_tasks.lock

# Handoff buffers — local-only working state, fully untracked.
# Senders write to _outbox/for-<receiver>/; receivers read via _inbox/from-<sender>/
# symlinks pointing into the sender's working tree. Per ~/Kouzou/standards/general.md
# these are gitignored so block-main-edits.sh allows handoff writes on main.
_outbox/
_inbox/

# Archived MiYo handoffs (locally-retained outbox copies; not part of repo history)
_archive/

# macOS
.DS_Store

# Node
node_modules/

# Misc
*.backup-*
*-backup-*.zip
__pycache__/

# Python virtualenv (host dev; container has its own)
venv/

# tcs-git-helpers per-repo setup lock (runtime artifact, never committed)
.githooks/.setup.lock
