#!/bin/bash
# update-tomo.sh — convenience shim for THIS Tomo instance.
# GENERATED by install-tomo.sh / update-tomo.sh — do not edit manually.
# Re-run either to regenerate with updated values.
# version: 0.1.0
#
# Delegates to the source repo's scripts/update-tomo.sh, targeting the instance
# whose tomo-install.json sits next to this shim. All arguments pass through, so
# `./update-tomo.sh --yolo`, `--dry-run`, `-f`, etc. work as documented there.
set -e

TOMO_REPO_ROOT="{{TOMO_REPO_ROOT}}"
INSTANCE_ROOT="$(cd "$(dirname "$0")" && pwd)"
REAL_UPDATER="$TOMO_REPO_ROOT/scripts/update-tomo.sh"
CONFIG_FILE="$INSTANCE_ROOT/tomo-install.json"

if [ ! -f "$REAL_UPDATER" ]; then
    printf '✗ update-tomo.sh not found in source repo: %s\n' "$REAL_UPDATER" >&2
    printf '  The source repo may have moved. Re-run install-tomo.sh from it.\n' >&2
    exit 1
fi
if [ ! -f "$CONFIG_FILE" ]; then
    printf '✗ tomo-install.json not found next to this shim: %s\n' "$CONFIG_FILE" >&2
    exit 1
fi

exec bash "$REAL_UPDATER" --config-file "$CONFIG_FILE" "$@"
