{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://miyo.tomo/schemas/suggestions-doc.schema.json",
  "title": "Suggestions Document (Reducer Output)",
  "description": "Internal JSON produced by suggestions-reducer.py; orchestrator renders this to the final markdown.",
  "type": "object",
  "required": ["schema_version", "generated", "run_id", "profile", "source_items", "sections"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1"},
    "generated": {"type": "string"},
    "run_id": {"type": "string"},
    "profile": {"type": "string"},
    "source_items": {"type": "integer", "minimum": 0},
    "doc_variant": {
      "type": "string",
      "enum": ["primary", "fan-resolve"],
      "description": "Document variant — primary (normal inbox run) or fan-resolve (XDD 012 force-atomic resolve doc)."
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "stem", "actions"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^S[0-9]{2,}$"},
          "stem": {"type": "string"},
          "actions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["kind", "rendered_md"],
              "additionalProperties": false,
              "properties": {
                "kind": {"type": "string"},
                "rendered_md": {"type": "string"},
                "suggestion_id": {
                  "type": "string",
                  "pattern": "^S[0-9]{2,}$",
                  "description": "Flat global per-atomic suggestion number (F-41 T1). Present only on create_atomic_note actions."
                },
                "candidate_mocs": {
                  "type": "array",
                  "description": "Structured Pass-1 placement anchors per candidate MOC (spec 022/023). Threaded to Pass-2 so suggestion-parser.py can use the LLM-resolved anchor as the apply-time default. Present only on create_atomic_note actions that carry MOC candidates.",
                  "items": {
                    "type": "object",
                    "required": ["path", "anchor"],
                    "additionalProperties": false,
                    "properties": {
                      "path": {"type": "string", "description": "Vault-relative MOC path."},
                      "anchor": {
                        "type": "object",
                        "description": "Resolved Pass-1 placement anchor (spec 022/023 item-result anchor shape).",
                        "required": ["type", "placement"],
                        "additionalProperties": false,
                        "properties": {
                          "type": {"type": "string", "enum": ["heading", "callout", "line"]},
                          "value": {"type": ["string", "null"]},
                          "placement": {"type": "string", "enum": ["before", "after", "inside"]},
                          "new_section": {"type": ["string", "null"]},
                          "alt_headings": {"type": "array", "items": {"type": "string", "pattern": "^[^\\n\\r]+$"}},
                          "fit_confidence": {"type": ["number", "null"]}
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "proposed_mocs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["topic", "items", "parent"],
        "additionalProperties": false,
        "properties": {
          "topic": {"type": "string"},
          "items": {"type": "array", "items": {"type": "string", "pattern": "^S[0-9]{2,}$"}},
          "parent": {"type": "string"},
          "tags": {"type": "array", "items": {"type": "string"}},
          "name": {"type": "string"},
          "note_titles": {"type": "array", "items": {"type": "string"}},
          "reason": {"type": "string"}
        }
      }
    },
    "daily_notes_updates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["daily_note_stem", "exists", "trackers", "log_entries", "log_links"],
        "additionalProperties": false,
        "properties": {
          "daily_note_stem": {"type": "string"},
          "exists": {"type": "boolean"},
          "trackers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["field", "value", "reason", "source_stem", "source_section"],
              "additionalProperties": false,
              "properties": {
                "field": {"type": "string"},
                "value": {},
                "reason": {"type": "string"},
                "source_stem": {"type": "string"},
                "source_section": {"type": "string", "pattern": "^S[0-9]{2,}$"}
              }
            }
          },
          "log_entries": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["content", "reason", "source_stem", "source_section"],
              "additionalProperties": false,
              "properties": {
                "time": {"type": ["string", "null"]},
                "time_source": {"type": ["string", "null"]},
                "content": {"type": "string"},
                "reason": {"type": "string"},
                "source_stem": {"type": "string"},
                "source_section": {"type": "string", "pattern": "^S[0-9]{2,}$"}
              }
            }
          },
          "log_links": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["target_stem", "reason", "source_stem", "source_section"],
              "additionalProperties": false,
              "properties": {
                "target_stem": {"type": "string"},
                "time": {"type": ["string", "null"]},
                "time_source": {"type": ["string", "null"]},
                "reason": {"type": "string"},
                "source_stem": {"type": "string"},
                "source_section": {"type": "string", "pattern": "^S[0-9]{2,}$"}
              }
            }
          }
        }
      }
    },
    "rendered_daily_updates_md": {"type": "string"},
    "tag_handler_updates": {
      "type": "array",
      "description": "Tag-handler group-result objects (spec 024 T3.3). Each element conforms to tag-handler-group.schema.json. Empty when --tag-handler-groups-dir is absent.",
      "items": {
        "type": "object",
        "required": ["schema_version", "handler", "target_path", "marker", "composed_block", "source_paths"],
        "additionalProperties": false,
        "properties": {
          "schema_version": {"const": "1"},
          "handler": {"type": "string"},
          "target_path": {"type": ["string", "null"]},
          "marker": {"type": "string"},
          "composed_block": {"type": "string"},
          "source_paths": {"type": "array", "items": {"type": "string"}},
          "placement": {"type": "string", "enum": ["inside", "before", "after"]},
          "compose_mode": {"type": "string", "enum": ["llm_directive", "field_template"]}
        }
      }
    },
    "rendered_tag_handler_updates_md": {
      "type": "string",
      "description": "Pre-rendered ## Tag-Handler Updates markdown section (spec 024 T3.3). Empty string when no groups."
    },
    "decision_precedence_note": {"type": "string"},
    "needs_attention": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stem", "error"],
        "additionalProperties": false,
        "properties": {
          "stem": {"type": "string"},
          "error": {"type": "string"}
        }
      }
    }
  }
}
