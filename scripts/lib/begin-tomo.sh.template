#!/bin/bash
# begin-tomo.sh — Start a Tomo Docker session.
# GENERATED by install-tomo.sh — do not edit manually.
# Re-run install-tomo.sh to regenerate with updated values.
# version: 0.16.0
set -e

# ── Hardcoded values (injected at install time) ──────────

INSTANCE_PATH="{{INSTANCE_PATH}}"
INSTANCE_NAME="{{INSTANCE_NAME}}"
HOME_DIR="{{HOME_DIR}}"
TOMO_REPO_ROOT="{{TOMO_REPO_ROOT}}"
DEV_NOTIFY_PORT="{{DEV_NOTIFY_PORT}}"
IMAGE_NAME="miyo-tomo:latest"

# ── Colors ────────────────────────────────────────────────

if [ -t 1 ]; then
    C_RESET="\033[0m"
    C_BOLD="\033[1m"
    C_DIM="\033[2m"
    C_CYAN="\033[36m"
    C_GREEN="\033[32m"
    C_YELLOW="\033[33m"
    C_RED="\033[31m"
else
    C_RESET="" C_BOLD="" C_DIM="" C_CYAN="" C_GREEN="" C_YELLOW="" C_RED=""
fi

print_step() { printf "\n${C_BOLD}${C_CYAN}▸ %s${C_RESET}\n" "$1"; }
print_ok()   { printf "  ${C_GREEN}✓${C_RESET} %s\n" "$1"; }
print_warn() { printf "  ${C_YELLOW}⚠${C_RESET} %s\n" "$1"; }
print_err()  { printf "  ${C_RED}✗${C_RESET} %s\n" "$1" >&2; }

# ── Instance config path ─────────────────────────────────
# Resolved once here; reused by defaultMode, version-check, and IDE-bridge
# blocks below.  INSTANCE_PATH is baked at install time — $(dirname) gives
# the install root that holds tomo-install.json for this specific instance.

CONFIG_FILE="$(dirname "$INSTANCE_PATH")/tomo-install.json"

# ── CLI Flags ─────────────────────────────────────────────

FORCE_REBUILD=false
BASH_MODE=false
YOLO_MODE=false
AUTO_MODE=false
SHOW_HELP=false
HAS_MODE_FLAG=false
EXPOSE_AUTH_PORT=true
AUTH_PORT_CLI_SET=false

while [ $# -gt 0 ]; do
    case "$1" in
        --rebuild-image) FORCE_REBUILD=true; shift ;;
        --bash)          BASH_MODE=true;  HAS_MODE_FLAG=true; shift ;;
        --yolo)          YOLO_MODE=true;  HAS_MODE_FLAG=true; shift ;;
        --auto)          AUTO_MODE=true;  HAS_MODE_FLAG=true; shift ;;
        --no-auth-port)  EXPOSE_AUTH_PORT=false; AUTH_PORT_CLI_SET=true; shift ;;
        --help|-h)       SHOW_HELP=true;     shift ;;
        *)
            print_err "Unknown option: $1"
            echo "Run with --help for usage." >&2
            exit 1
            ;;
    esac
done

# ── Default mode from tomo-install.json ──────────────────
# If no mode flag was passed on the CLI, check for a configured default.
# User sets "defaultMode" in tomo-install.json: "default", "auto", "yolo", or "bash".

if [ "$HAS_MODE_FLAG" = "false" ] && [ "$SHOW_HELP" = "false" ] && command -v jq > /dev/null 2>&1; then
    if [ -f "$CONFIG_FILE" ]; then
        DEFAULT_MODE="$(jq -r '.defaultMode // "default"' "$CONFIG_FILE")"
        case "$DEFAULT_MODE" in
            yolo) YOLO_MODE=true ;;
            auto) AUTO_MODE=true ;;
            bash) BASH_MODE=true ;;
            default|"") ;; # no-op, standard interactive mode
            *)
                print_warn "Unknown defaultMode in tomo-install.json: '$DEFAULT_MODE' — ignoring"
                ;;
        esac
    fi
fi

# ── Auth-port exposure from tomo-install.json ────────────
# CLI --no-auth-port wins; otherwise read "exposeAuthPort" (default true).
# Disable to avoid a host-port collision when running multiple instances.
# NOTE: read the raw value, NOT `.exposeAuthPort // true` — jq's `//`
# returns the right side when the left is null OR false, so the `//`
# form would mis-read an explicit `false` as `true`. Absent field → "null"
# → falls through to the default (exposed).

if [ "$AUTH_PORT_CLI_SET" = "false" ] && command -v jq > /dev/null 2>&1; then
    if [ -f "$CONFIG_FILE" ]; then
        if [ "$(jq -r '.exposeAuthPort' "$CONFIG_FILE")" = "false" ]; then
            EXPOSE_AUTH_PORT=false
        fi
    fi
fi

if [ "$SHOW_HELP" = "true" ]; then
    cat <<HELPEOF
Usage: bash begin-tomo.sh [OPTIONS]

Start a Tomo Docker session for instance: ${INSTANCE_NAME}

Options:
  --rebuild-image   Force rebuild of the Docker image before launch
  --bash            Launch a bash shell instead of Claude Code.
                    Useful for debugging the container environment.
  --auto            Auto mode — AI classifier approves safe actions
                    automatically. You still get prompted for risky
                    operations. Recommended for interactive sessions.
  --yolo            Skip ALL permission prompts (bypass permissions).
                    Tomo runs in a sandboxed Docker container with
                    no direct vault access — all writes go through
                    Kado MCP. Use for unattended sessions.
  --no-auth-port    Do NOT expose host port 10000 (the Claude Code
                    OAuth callback port). Exposed by default; disable
                    to avoid a host-port collision when running
                    multiple instances side by side.
  --help, -h        Show this help

Default mode:
  Set "defaultMode" in tomo-install.json to change what happens
  when you run begin-tomo.sh without flags:
    "default"  — standard interactive (permission prompts)
    "auto"     — AI classifier approves safe actions
    "yolo"     — skip all permission prompts
    "bash"     — launch shell instead of Claude

Auth port:
  Host port 10000 (Claude Code OAuth callback) is exposed by default.
  Set "exposeAuthPort": false in tomo-install.json to disable it
  persistently, or pass --no-auth-port for a single run. The CLI flag
  wins over the config value.

Paths (baked in at install time):
  Instance:  ${INSTANCE_PATH}
  Home:      ${HOME_DIR}
  Tomo src:  ${TOMO_REPO_ROOT}

To refresh these values, re-run: bash ${TOMO_REPO_ROOT}/scripts/install-tomo.sh
HELPEOF
    exit 0
fi

# ── Splash screen ─────────────────────────────────────────

show_splash() {
    local logo_file="$TOMO_REPO_ROOT/assets/tomo-small-logo-50-2.txt"
    local version="unknown"
    local version_file="$TOMO_REPO_ROOT/tomo/dot_claude/rules/project-context.md"
    if [ -f "$version_file" ]; then
        version="$(grep -m1 '^# version:' "$version_file" 2>/dev/null \
            | sed 's/^# version: *//' || echo 'unknown')"
    fi

    [ -f "$logo_file" ] || return 0

    local C_MAGENTA_BOLD="\033[1;35m"
    local C_DIM="\033[2m"
    local C_CYAN_SPLASH="\033[36m"
    local C_RESET_SPLASH="\033[0m"
    if [ ! -t 1 ]; then
        C_MAGENTA_BOLD="" C_DIM="" C_CYAN_SPLASH="" C_RESET_SPLASH=""
    fi

    printf "\n"
    awk '
        { lines[NR] = $0 }
        END {
            first = 1
            while (first <= NR && lines[first] ~ /^[[:space:]]*$/) first++
            last = NR
            while (last >= first && lines[last] ~ /^[[:space:]]*$/) last--
            for (i = first; i <= last; i++) print lines[i]
        }
    ' "$logo_file"
    printf "\n"
    printf "               %b友  MiYo Tomo%b %bv%s%b\n" \
        "$C_MAGENTA_BOLD" "$C_RESET_SPLASH" "$C_DIM" "$version" "$C_RESET_SPLASH"
    printf "           %bPersonal Knowledge Companion%b\n" "$C_CYAN_SPLASH" "$C_RESET_SPLASH"
    printf "             AI handles processes,\n"
    printf "                 not decisions\n"
}

show_splash

# ── Pre-flight ────────────────────────────────────────────

if ! docker info > /dev/null 2>&1; then
    print_err "Docker is not running. Start OrbStack or Docker Desktop."
    exit 1
fi

if [ ! -d "$INSTANCE_PATH" ]; then
    print_err "Instance directory not found: $INSTANCE_PATH"
    print_err "Re-run: bash ${TOMO_REPO_ROOT}/scripts/install-tomo.sh"
    exit 1
fi

if [ ! -d "$HOME_DIR" ]; then
    print_err "Home directory not found: $HOME_DIR"
    print_err "Re-run: bash ${TOMO_REPO_ROOT}/scripts/install-tomo.sh"
    exit 1
fi

# ── Version compare helper (ADR-4, T3.3) ─────────────────
# Portable bash-3.2 semver compare: field-by-field numeric (0.9.0 < 0.10.0).
# Echoes "behind" | "ahead" | "equal" | "unknown".  ALWAYS returns 0 so
# result=$(_version_compare a b) never trips set -e.
_version_compare() {
    local _a="$1" _b="$2"
    # Reject non-numeric / unknown / empty inputs.
    case "$_a" in
        ''|unknown|*[!0-9.]*) printf 'unknown'; return 0 ;;
    esac
    case "$_b" in
        ''|unknown|*[!0-9.]*) printf 'unknown'; return 0 ;;
    esac
    # Split on '.' into up to 4 fields; missing fields default to 0.
    local _a1=0 _a2=0 _a3=0 _a4=0
    local _b1=0 _b2=0 _b3=0 _b4=0
    IFS='.' read -r _a1 _a2 _a3 _a4 <<EOF_A
$_a
EOF_A
    IFS='.' read -r _b1 _b2 _b3 _b4 <<EOF_B
$_b
EOF_B
    _a1=${_a1:-0}; _a2=${_a2:-0}; _a3=${_a3:-0}; _a4=${_a4:-0}
    _b1=${_b1:-0}; _b2=${_b2:-0}; _b3=${_b3:-0}; _b4=${_b4:-0}
    # Guard: each field must be purely numeric after splitting.
    case "$_a1$_a2$_a3$_a4$_b1$_b2$_b3$_b4" in
        *[!0-9]*) printf 'unknown'; return 0 ;;
    esac
    # Numeric field-by-field comparison.
    for _pair in "$_a1:$_b1" "$_a2:$_b2" "$_a3:$_b3" "$_a4:$_b4"; do
        local _fa="${_pair%%:*}" _fb="${_pair##*:}"
        if [ "$(( _fa ))" -lt "$(( _fb ))" ]; then
            printf 'behind'; return 0
        elif [ "$(( _fa ))" -gt "$(( _fb ))" ]; then
            printf 'ahead';  return 0
        fi
    done
    printf 'equal'; return 0
}

# ── Version check (optional, non-fatal — always proceeds to launch) ──
# ADR-4: warn only when instance is BEHIND source; ahead/equal → silent.
# CONFIG_FILE was hoisted above CLI flags — already points to the
# instance-specific tomo-install.json.

SOURCE_VERSION_FILE="$TOMO_REPO_ROOT/tomo/dot_claude/rules/project-context.md"

# Resolve INSTANCE_VERSION unconditionally so we can export it into the
# container. Falls back to "unknown" when jq or tomo-install.json is missing.
INSTANCE_VERSION="unknown"
if [ -f "$CONFIG_FILE" ] && command -v jq > /dev/null 2>&1; then
    INSTANCE_VERSION="$(jq -r '.tomoVersion // "unknown"' "$CONFIG_FILE")"
fi

if [ -f "$SOURCE_VERSION_FILE" ]; then
    SOURCE_VERSION="$(grep -m1 '^# version:' "$SOURCE_VERSION_FILE" 2>/dev/null \
        | sed 's/^# version: *//' || echo 'unknown')"
    _vc_result="$(_version_compare "$INSTANCE_VERSION" "$SOURCE_VERSION")"
    if [ "$_vc_result" = "behind" ]; then
        echo ""
        print_warn "Instance ($INSTANCE_VERSION) is behind source ($SOURCE_VERSION)"
        printf "  Run: ${C_CYAN}bash %s/scripts/update-tomo.sh --instance %s${C_RESET}\n" \
            "$TOMO_REPO_ROOT" "$INSTANCE_NAME"
        echo ""
        read -rp "  Update now? [y/N] " ans
        case "$ans" in
            [yY]*) bash "$TOMO_REPO_ROOT/scripts/update-tomo.sh" --instance "$INSTANCE_NAME" \
                       && exec "$0" "$@" ;;
            *) : ;;  # launch anyway
        esac
    fi
    unset _vc_result
fi

# ── dev-notify-bridge lifecycle ───────────────────────────

print_step "Checking dev-notify-bridge"

case "$(uname -s)" in
    Darwin)
        if ! command -v terminal-notifier > /dev/null 2>&1; then
            print_warn "terminal-notifier not installed — desktop notifications may not appear"
            echo "  Install with: brew install terminal-notifier"
        fi
        ;;
    Linux)
        if ! command -v notify-send > /dev/null 2>&1; then
            print_warn "notify-send not found — desktop notifications may not appear"
            echo "  Install with: sudo apt install libnotify-bin"
        fi
        ;;
esac

if ! curl -s "http://localhost:${DEV_NOTIFY_PORT}/health" > /dev/null 2>&1; then
    if command -v npx > /dev/null 2>&1; then
        npx dev-notify-bridge --port "$DEV_NOTIFY_PORT" &
        sleep 1
        print_ok "dev-notify-bridge started on port $DEV_NOTIFY_PORT"
    else
        print_warn "npx not found — dev-notify-bridge not started"
    fi
else
    print_ok "dev-notify-bridge already running on port $DEV_NOTIFY_PORT"
fi

# ── Voice transcription build state (XDD 009) ────────────
# The Dockerfile accepts VOICE_ENABLED as a build arg. We label the built
# image so subsequent starts can detect when the user's choice drifted
# (e.g. toggled voice via update-tomo.sh) and trigger an automatic rebuild.
#
# Read from the INSTANCE mirror ($INSTANCE_PATH/voice/config.json) rather
# than tomo-install.json — the mirror is what runtime agents actually see
# inside the container. If the two disagree (e.g. stale mirror after a
# manual edit), this makes the banner and build-arg reflect container
# reality, and a re-run of install/update-tomo will re-sync both.

VOICE_ENABLED="0"
VOICE_MODEL_RUNTIME=""
VOICE_LANG_RUNTIME="auto"
VOICE_CONFIG_MIRROR="$INSTANCE_PATH/voice/config.json"
# Single jq call — returns tab-separated enabled/model/language so we
# don't spawn three jq processes on every launch (review finding M16).
if [ -f "$VOICE_CONFIG_MIRROR" ] && command -v jq > /dev/null 2>&1; then
    _voice_triple="$(jq -r '[(.enabled // false | tostring), (.model // ""), (.language // "auto")] | @tsv' "$VOICE_CONFIG_MIRROR")"
    if [ -n "$_voice_triple" ]; then
        IFS=$'\t' read -r _venabled VOICE_MODEL_RUNTIME VOICE_LANG_RUNTIME <<< "$_voice_triple"
        [ "$_venabled" = "true" ] && VOICE_ENABLED="1"
        unset _voice_triple _venabled
    fi
fi

# ── IDE Bridge config (XDD 019) ──────────────────────────
# Read enabled/port from tomo-install.json (host-side config). No instance
# mirror — begin-tomo.sh runs on the host where tomo-install.json lives.
# Falls back to disabled / port 23027 when the key is absent or jq unavailable.

IDE_BRIDGE_ENABLED="false"
IDE_BRIDGE_PORT="23027"
if [ -f "$CONFIG_FILE" ] && command -v jq > /dev/null 2>&1; then
    # Single jq call — tab-separated enabled/port to avoid spawning two processes.
    set +e
    _ide_pair="$(jq -r '[(.ide_bridge.enabled // false | tostring), (.ide_bridge.port // 23027 | tostring)] | @tsv' "$CONFIG_FILE" 2>/dev/null)"
    set -e
    if [ -n "$_ide_pair" ]; then
        IFS=$'\t' read -r _ide_enabled _ide_port_raw <<< "$_ide_pair"
        [ "$_ide_enabled" = "true" ] && IDE_BRIDGE_ENABLED="true"
        [ -n "$_ide_port_raw" ] && IDE_BRIDGE_PORT="$_ide_port_raw"
        unset _ide_pair _ide_enabled _ide_port_raw
    fi
fi

# Host-side TCP reachability probe (ADR-3) — ≤3s, never blocks launch.
# Uses a background bash /dev/tcp connect with kill-on-timeout guard.
# Returns 0 (reachable) or 1 (unreachable / timeout).
_probe_ide_bridge() {
    local _port="$1"
    local _pid
    # Spawn the connect attempt in a subshell so we can kill it if needed.
    ( exec 3<>"/dev/tcp/127.0.0.1/${_port}" ) 2>/dev/null &
    _pid=$!
    local _i=0
    while [ "$_i" -lt 3 ]; do
        if ! kill -0 "$_pid" 2>/dev/null; then
            wait "$_pid" 2>/dev/null
            return $?
        fi
        sleep 1
        _i=$(( _i + 1 ))
    done
    kill "$_pid" 2>/dev/null || true
    wait "$_pid" 2>/dev/null || true
    return 1
}

# ── Docker image ──────────────────────────────────────────

BUILD_CONTEXT="$TOMO_REPO_ROOT/docker"

build_image() {
    if [ ! -f "$BUILD_CONTEXT/Dockerfile" ]; then
        print_err "Dockerfile not found: $BUILD_CONTEXT/Dockerfile"
        print_err "Tomo source repo appears broken or moved."
        exit 1
    fi
    docker build \
        --build-arg "VOICE_ENABLED=$VOICE_ENABLED" \
        --label "tomo.voice_enabled=$VOICE_ENABLED" \
        --label "tomo.has_socat=1" \
        -t "$IMAGE_NAME" "$BUILD_CONTEXT"
    print_ok "Image built: $IMAGE_NAME (voice_enabled=$VOICE_ENABLED)"
}

# Resolve the image state once — combines the "does the image exist?"
# check with the drift-label reads to avoid multiple `docker image inspect`
# calls per launch (review finding M16). Empty label value means no image
# or pre-feature image (review M17).
#
# bash 3.2 guard: `set -e` treats a failing command substitution inside
# a variable assignment as a script-terminating error (unlike bash 4+).
# `docker image inspect` on a missing image exits 1, so the assignment
# below would silently kill the launcher before we ever get to read
# `_IMAGE_INSPECT_RC`. Suspend errexit around each capture.
set +e
_IMAGE_VOICE_STATE="$(docker image inspect --format '{{ index .Config.Labels "tomo.voice_enabled" }}' "$IMAGE_NAME" 2>/dev/null)"
_IMAGE_INSPECT_RC=$?
set -e

# Read socat label only when image exists (avoids a second failing inspect).
_IMAGE_SOCAT_STATE=""
if [ "$_IMAGE_INSPECT_RC" -eq 0 ]; then
    set +e
    _IMAGE_SOCAT_STATE="$(docker image inspect --format '{{ index .Config.Labels "tomo.has_socat" }}' "$IMAGE_NAME" 2>/dev/null)"
    set -e
fi

if [ "$FORCE_REBUILD" = "true" ]; then
    print_step "Rebuilding Docker image (forced)"
    build_image
elif [ "$_IMAGE_INSPECT_RC" -ne 0 ]; then
    print_step "Building Docker image (first time)"
    build_image
elif [ -z "$_IMAGE_VOICE_STATE" ]; then
    # Pre-feature image — has no tomo.voice_enabled label. One-time
    # rebuild to bring it up to the labeled scheme; the message is
    # distinct from the normal "voice setting changed" path so the user
    # isn't confused about why a rebuild is happening if they haven't
    # toggled anything (review finding M17).
    print_step "Rebuilding Docker image (first run with voice-labeled image)"
    build_image
elif [ "$_IMAGE_VOICE_STATE" != "$VOICE_ENABLED" ]; then
    print_step "Rebuilding Docker image (voice setting changed)"
    build_image
elif [ -z "$_IMAGE_SOCAT_STATE" ]; then
    # Pre-socat image — has no tomo.has_socat label. One-time rebuild to
    # bring it up to the socat-capable image. Distinct message so the user
    # isn't confused about a spontaneous rebuild with no config change.
    print_step "Rebuilding Docker image (first run with socat-labeled image)"
    build_image
else
    print_ok "Image exists: $IMAGE_NAME (voice_enabled=$VOICE_ENABLED)"
fi
unset _IMAGE_VOICE_STATE _IMAGE_SOCAT_STATE _IMAGE_INSPECT_RC

# ── Auth ──────────────────────────────────────────────────
# Port 10000 is exposed for the Claude Code OAuth callback so credentials
# can be refreshed without restarting the container. Exposed by default;
# disable with --no-auth-port or "exposeAuthPort": false in tomo-install.json
# (e.g. to avoid a host-port collision when running multiple instances).

if [ "$EXPOSE_AUTH_PORT" = "false" ]; then
    AUTH_FLAGS=()
    print_ok "Auth port 10000 not exposed (--no-auth-port / exposeAuthPort:false)"
else
    AUTH_FLAGS=(-p 10000:10000)
fi

if [ ! -f "$HOME_DIR/.claude/.credentials.json" ]; then
    print_warn "No credentials found — run 'claude login' inside the container"
else
    print_ok "Auth state found (.credentials.json)"
fi

# ── Stop any existing container with the same name ───────

CONTAINER_NAME="tomo-${INSTANCE_NAME}"

if docker ps -q -f "name=^${CONTAINER_NAME}$" 2>/dev/null | grep -q .; then
    docker stop "$CONTAINER_NAME" > /dev/null 2>&1 || true
fi
if docker ps -aq -f "name=^${CONTAINER_NAME}$" 2>/dev/null | grep -q .; then
    docker rm "$CONTAINER_NAME" > /dev/null 2>&1 || true
fi

# ── First-run detection ──────────────────────────────────
# The discovery cache is created by /explore-vault. If it's missing,
# this is either a fresh install or the user hasn't explored yet.

# Check both canonical (config/) and legacy (.claude/) paths
DISCOVERY_CACHE="$INSTANCE_PATH/config/discovery-cache.yaml"
DISCOVERY_CACHE_ALT="$INSTANCE_PATH/.claude/discovery-cache.yaml"
if [ ! -f "$DISCOVERY_CACHE" ] && [ ! -f "$DISCOVERY_CACHE_ALT" ] && [ "$BASH_MODE" != "true" ]; then
    echo ""
    printf "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}\n"
    printf "  ${C_BOLD}First run detected — welcome to Tomo!${C_RESET}\n"
    echo ""
    printf "  Start with a single command:\n"
    echo ""
    printf "    ${C_BOLD}/tomo-setup${C_RESET}     — vault discovery + user rules + templates\n"
    printf "                      (recommended — covers everything you need)\n"
    echo ""
    printf "  After setup:\n"
    echo ""
    printf "    ${C_BOLD}/inbox${C_RESET}          — process items in your inbox\n"
    printf "    ${C_BOLD}/tomo-help${C_RESET}      — context-aware help anytime\n"
    echo ""
    printf "  ${C_DIM}Power users: /explore-vault standalone, /tomo-setup check for status${C_RESET}\n"
    printf "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}\n"
fi

# ── Launch ────────────────────────────────────────────────

print_step "Starting Tomo container: $CONTAINER_NAME"
printf "  Instance: ${C_CYAN}%s${C_RESET}\n" "$INSTANCE_PATH"
printf "  Home:     ${C_CYAN}%s${C_RESET}\n" "$HOME_DIR"

# Voice status — one line, color-coded. Reads the instance mirror
# (the source runtime agents actually consume).
if [ "$VOICE_ENABLED" = "1" ]; then
    VOICE_MODEL_DIR="$INSTANCE_PATH/voice/models/faster-whisper-${VOICE_MODEL_RUNTIME}"
    if [ -f "$VOICE_MODEL_DIR/.download-complete" ]; then
        printf "  Voice:    ${C_GREEN}ENABLED${C_RESET} — model=%s, lang=%s\n" \
            "${VOICE_MODEL_RUNTIME:-?}" "${VOICE_LANG_RUNTIME}"
    else
        printf "  Voice:    ${C_YELLOW}ENABLED (model missing — re-run install-tomo.sh)${C_RESET} — expected=%s\n" \
            "$VOICE_MODEL_DIR"
    fi
else
    printf "  Voice:    ${C_DIM}disabled${C_RESET}\n"
fi

# Tomo Context status — one line, color-coded (ADR-3, F6). Probe is non-blocking:
# a failed or timed-out probe prints a warning but never prevents container launch.
if [ "$IDE_BRIDGE_ENABLED" = "true" ]; then
    IDE_BRIDGE_REACHABLE=false
    if _probe_ide_bridge "$IDE_BRIDGE_PORT"; then
        IDE_BRIDGE_REACHABLE=true
    fi
    if [ "$IDE_BRIDGE_REACHABLE" = "true" ]; then
        printf "  Context:  ${C_GREEN}connected${C_RESET} — port=%s\n" "$IDE_BRIDGE_PORT"
    else
        printf "  Context:  ${C_YELLOW}configured (Hashi unreachable)${C_RESET} — port=%s\n" \
            "$IDE_BRIDGE_PORT"
        print_warn "Tomo Context: Hashi not reachable on port ${IDE_BRIDGE_PORT} — editor context unavailable"
    fi
else
    printf "  Context:  ${C_DIM}not configured${C_RESET}\n"
fi

if [ "$BASH_MODE" = "true" ]; then
    CMD=(bash)
    print_warn "Bash mode — launching shell instead of claude"
else
    CMD=(claude)
    if [ "$YOLO_MODE" = "true" ]; then
        CMD+=(--dangerously-skip-permissions)
        print_warn "YOLO mode — all permission prompts bypassed"
    elif [ "$AUTO_MODE" = "true" ]; then
        CMD+=(--permission-mode auto)
        print_ok "Auto mode — AI classifier approves safe actions"
    fi
fi

VOICE_MOUNT_FLAGS=()
if [ "$VOICE_ENABLED" = "1" ] && [ -d "$INSTANCE_PATH/voice/models" ]; then
    VOICE_MOUNT_FLAGS+=(-v "$INSTANCE_PATH/voice:/tomo/voice:ro")
    # Mount confirmation is silent — the "Voice: ENABLED" line above
    # already announced runtime state to the user.
fi

# ── Hostname sanitizer (ADR-3, T3.2) ─────────────────────────────────────────
# Docker --hostname accepts only [a-zA-Z0-9-]. INSTANCE_NAME may contain
# spaces, dots, colons, or other chars (e.g. "My Vault!").
# Maps every non-[a-zA-Z0-9-] char to '-', collapses runs, strips ends.
# Empty result falls back to 'tomo' so the hostname is always valid.
_sanitize_hostname() {
    local raw="$1"
    local s
    s=$(printf '%s' "$raw" | tr -c 'a-zA-Z0-9-' '-')
    s=$(printf '%s' "$s" | sed 's/-\{1,\}/-/g; s/^-//; s/-$//')
    if [ -z "$s" ]; then
        s="tomo"
    fi
    printf '%s' "$s"
}

SANITIZED_HOSTNAME="$(_sanitize_hostname "$INSTANCE_NAME")"

docker run -it --rm \
    --name "$CONTAINER_NAME" \
    --label "miyo.component=tomo" \
    --label "miyo.plugin-enabled=true" \
    --label "miyo.tomo.instance-name=$INSTANCE_NAME" \
    --hostname "$SANITIZED_HOSTNAME" \
    --add-host "host.docker.internal:host-gateway" \
    -w "$INSTANCE_PATH" \
    "${AUTH_FLAGS[@]}" \
    -e "TERM=xterm-256color" \
    -e "TOMO_INSTANCE_DIR=$INSTANCE_PATH" \
    -e "TOMO_INSTANCE_NAME=$INSTANCE_NAME" \
    -e "TOMO_VERSION=$INSTANCE_VERSION" \
    -e "DEV_NOTIFY_PORT=$DEV_NOTIFY_PORT" \
    -v "$INSTANCE_PATH:$INSTANCE_PATH" \
    -v "$HOME_DIR:/home/coder" \
    "${VOICE_MOUNT_FLAGS[@]}" \
    "$IMAGE_NAME" \
    "${CMD[@]}"
